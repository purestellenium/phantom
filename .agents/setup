#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

echo "Setting up Phantom..."

if ! command -v bun >/dev/null 2>&1; then
  echo "Installing Bun..."
  curl -fsSL https://bun.sh/install | bash
  export BUN_INSTALL="${BUN_INSTALL:-$HOME/.bun}"
  export PATH="$BUN_INSTALL/bin:$PATH"
fi

echo "Installing dependencies from bun.lock..."
bun install --frozen-lockfile

# Unlike the landing page, this app has a database behind it. Everything below
# is skipped rather than failed when there is no DATABASE_URL: an orb that only
# needs to typecheck or read the tree should not be blocked on Postgres.
if [ -f .env ] && grep -q '^DATABASE_URL=.\+' .env; then
  echo "Applying migrations..."
  bun run db:migrate
  echo "Seeding..."
  bun run db:seed
else
  echo "No DATABASE_URL in .env — skipping migrate and seed."
  echo "Copy .env.example to .env and fill it in to run against a database."
fi

echo "Setup complete."
