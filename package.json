{
	"name": "phantom-sv",
	"private": true,
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:start": "docker compose up",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun run src/lib/server/db/migrate.ts",
		"db:seed": "bun run src/lib/server/db/seed.ts",
		"db:seed:demo": "bun run src/lib/server/db/seed-demo.ts",
		"db:seed:demo:local": "bun run src/lib/server/db/seed-demo.ts --local",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.48.0",
		"@plausible-analytics/tracker": "0.4.6",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.2",
		"@types/d3-geo": "3.1.0",
		"@types/node": "^20",
		"@types/sanitize-html": "^2.16.1",
		"@types/topojson-client": "3.1.5",
		"bits-ui": "^2.19.3",
		"clsx": "^2.1.1",
		"d3-geo": "3.1.1",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"postgres": "^3.4.9",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"topojson-client": "3.1.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"world-atlas": "2.0.2"
	},
	"dependencies": {
		"marked": "^18.0.14",
		"sanitize-html": "^2.17.7",
		"sharp": "0.35.3"
	}
}
