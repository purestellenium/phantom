# Copy to .env and fill in. Nothing here has a default: every value is either a
# secret or an address that differs per environment, and a fallback for either
# is a way to ship the wrong one without noticing.

# ── database ────────────────────────────────────────────────────────────────
# Local development against the Postgres from `bun run db:start` (compose.yaml),
# or a local install. In production this is the pooled connection string from
# the host.
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

# ── this app ────────────────────────────────────────────────────────────────
# 32 bytes, as 64 hex characters. Encrypts the provider tokens held in the
# database. Generate with:
#
#   openssl rand -hex 32
#
# There is no development default on purpose. Rotating this without a
# re-encryption pass invalidates every stored token and forces everyone to
# relink, so treat it the way you would a database password.
ENCRYPTION_KEY=

# ── uploads ─────────────────────────────────────────────────────────────────
# Read by the node server, not by this application: it is how much request body
# it will accept, and it defaults to 512K — smaller than a screenshot. A body
# over the limit is refused while it is still being read, so no form action ever
# runs and the reader gets an error page rather than a message on the form.
# Keep it above MAX_IMAGE_BYTES in src/lib/images.ts (10 MB) with room for the
# rest of the fields. Nothing to set for `vite dev`, which has no such limit.
BODY_SIZE_LIMIT="12M"

# ── staging mode ────────────────────────────────────────────────────────────
# For developing without HCA or Hackatime credentials. Under `vite dev` it is
# on by default while HCA_CLIENT_ID/SECRET are unset, or forced with STAGING=1;
# STAGING=0 turns it off. While on, the signed-in pages sign you in as a local
# developer account, everybody is linked to a fake Hackatime account with a
# fixed project list, and HCA re-checks report verified and eligible with one
# fake address. Ignored
# by a production build, whatever it is set to. STAGING_ROLE picks the
# developer account's role (participant, reviewer, admin, owner; default
# owner) and is re-read on every request. See src/lib/server/staging.ts.
# STAGING=1
# STAGING_ROLE=owner

# ── hack club auth ──────────────────────────────────────────────────────────
# Sign-in. Register a Program with HCA; self-service registration produces a
# `community_untrusted` client, which is enough for the scopes this app asks
# for.
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=

# ── hackatime ───────────────────────────────────────────────────────────────
# Linked as a second account, not as a way to sign in. Register an OAuth
# application with Hackatime.
HACKATIME_CLIENT_ID=
HACKATIME_CLIENT_SECRET=

# ── provider callbacks ──────────────────────────────────────────────────────
# There is no redirect-URI variable and no APP_URL. Both callbacks are derived
# from the request being served:
#
#   https://<this host>/api/auth/hca/callback
#   https://<this host>/api/auth/hackatime/callback
#
# so they are correct in production, in a preview and on localhost with nothing
# set. Register the pair that /admin/settings prints for the host you are
# deploying to. A preview deployment answers on its own hostname, so it needs
# its own pair registered if you want to sign in there.

# Optional host overrides, for staging or a local instance. They default to
# https://auth.hackclub.com and https://hackatime.hackclub.com.
# HCA_HOST=
# HACKATIME_HOST=

# ── slack ───────────────────────────────────────────────────────────────────
# Three things run on the bot token: order and review notifications (delivered
# through the outbox by a worker rather than inline), the avatar lookup at
# sign-in, and adding each participant to the Phantom channel. Optional: with
# the token unset, Slack effects settle as `deferred` — never attempted, and
# sent by themselves once the token arrives — rather than failing, which is the
# honest state for an integration nobody has connected yet.
#
# Scopes: `chat:write` to post, `users:read` for the avatar, and
# `channels:write.invites` to add someone to the Phantom channel — for which
# the bot also has to be in that channel itself, or every invite comes back
# `not_in_channel`. Adding a scope means reinstalling the app to the workspace;
# until then invites settle as `failed` with `missing_scope`, visible in the
# outbox console. The Phantom channel is not configured here: there is one of
# it and it is named in src/lib/server/effects/slack.ts.
#
# SLACK_CHANNEL_ID is the OPERATOR channel, where orders and ships are
# announced. Only those notifications need it.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# ── cdn ─────────────────────────────────────────────────────────────────────
# Bearer token for cdn.hackclub.com, used to upload project screenshots
# (src/lib/server/cdn.ts). Optional: with this unset, the upload is refused
# with a legible "not available right now" rather than the app failing to
# start — nothing else on this page depends on it.
CDN_API_KEY=

# ── scheduled jobs ──────────────────────────────────────────────────────────
# The bearer token /api/jobs/run expects. Nothing in this application runs on a
# timer: a scheduler posts to that endpoint, which is the only way the session
# sweep, the outbox dispatch and the integrity checks ever run.
#
#   openssl rand -base64 32
#
# Unset DISABLES the endpoint rather than opening it. It answers 404 either
# way — to a wrong credential and to being switched off — so neither tells a
# caller which it was. Minimum 32 characters, refused at startup below that.
CRON_SECRET=

# ── ari ─────────────────────────────────────────────────────────────────────
# Ari reviews every project shipped here. Phantom sends each ship to Ari's
# ingest endpoint, and Ari sends every decision back to /api/ari/webhook.
# All three come from Ari's Settings -> Webhooks for the program:
#   ARI_PROGRAM: the program id in Ari's ingest URLs.
#   ARI_INGEST_SECRET: the signing secret for what Phantom sends (whsec_...).
#     Unset leaves ships DEFERRED in the outbox - recorded, sent once it is set.
#   ARI_WEBHOOK_SECRET: the outbound signing secret, for what Ari sends back.
#     A separate secret. Unset makes the webhook answer 503, which Ari retries.
# Set the webhook destination in Ari to https://<this site>/api/ari/webhook.
ARI_PROGRAM=
ARI_INGEST_SECRET=
ARI_WEBHOOK_SECRET=

# ── bootstrap ───────────────────────────────────────────────────────────────
# Comma-separated HCA subject identifiers promoted to admin the first time they
# sign in, and granted the capabilities an admin role does not imply —
# `view_pii` and `adjust_ledger`. This is the answer to "who grants the first
# grant"; everyone else is granted upward by one of these people, by name.
#
# It only seeds. Every authorization check reads the column, so removing someone
# from here does not demote them — change the role. It is a floor, not a
# ceiling: capabilities granted to a bootstrap admin by a colleague survive
# their next sign-in.
ADMIN_HCA_SUBJECTS=

# ── bootstrap: owners ───────────────────────────────────────────────────────
# Comma-separated HCA subject identifiers promoted to OWNER the first time they
# sign in. Owner is the rank above admin and the only role that can appoint
# other owners — canActOn refuses acting on an equal rank — so this is the
# answer to "who appoints the first owner". Without it, the first owner can only
# be set by hand in psql. Owner outranks admin, so a subject named in both lists
# is seeded owner; it needs no capability list because the owner role already
# implies every capability.
#
# Same rules as ADMIN_HCA_SUBJECTS: it only seeds, and only promotes. Removing
# someone here does not demote them — change the role.
OWNER_HCA_SUBJECTS=

# ── airtable (waiting list) ─────────────────────────────────────────────────
# The landing page's sign-up field while the site is closed. Once the launch
# switch in the console is on, the same field signs people up through Hack Club
# instead and none of this is read.
# AIRTABLE_API_KEY: a personal access token (airtable.com/create/tokens) scoped
# to this base with the data.records:read and data.records:write permissions.
# AIRTABLE_BASE_ID: the app... id from the base's API docs page.
# AIRTABLE_TABLE_NAME: the table to write signups to (name or tbl... id). The
# `loops.sync` job keeps every account in the same table, with
# "Loops - phantomSignUpAt" (a date field, so the sync can write it) and
# "Loops - phantomHasShippedAProject"; it also needs the schema.bases:read
# permission to read that date field's type.
# AIRTABLE_EMAIL_FIELD: the field in that table to store the email in, defaults
# to "Email" if unset.
AIRTABLE_API_KEY=""
AIRTABLE_BASE_ID=""
AIRTABLE_TABLE_NAME=""
AIRTABLE_EMAIL_FIELD="Email"
# AIRTABLE_SUBMISSIONS_TABLE: the table approved project submissions are filed to
# (the YSWS records base), separate from the waiting-list table above; it reuses
# AIRTABLE_API_KEY and AIRTABLE_BASE_ID. Unset leaves the
# `airtable.submission_approved` outbox effect DEFERRED — recorded, not lost — so
# approvals still mint hours and Slack still fires; set it to start filing
# records, and adjust the field names in src/lib/server/effects/airtable.ts to
# match the base.
AIRTABLE_SUBMISSIONS_TABLE=""


# ── github ──────────────────────────────────────────────────────────────────
# Optional. A fine-grained token with public read only, for the ship-time check
# that a repository is public (Ari can only read public ones). Unset uses
# GitHub's anonymous API, and a check that cannot be made lets the ship through.
GITHUB_TOKEN=""

# Optional. Product analytics, sent to Plausible (lib/server/analytics.ts and
# lib/analytics/client.ts). Unset, they run only when served at
# phantom.hackclub.com, so production needs nothing and a local checkout, a
# preview or staging sends nothing. Set it to send from any host to that domain.
# The endpoint defaults to https://plausible.io/api/event; set it for a proxy.
PLAUSIBLE_DOMAIN=""
PLAUSIBLE_ENDPOINT=""
# Optional. A Plausible Stats API key (Plausible → account settings → API keys),
# which /admin/analytics reads its numbers with. A secret: it reads the whole
# dashboard. Unset, the page says it is not configured.
PLAUSIBLE_API_KEY=""
